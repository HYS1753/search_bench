# LLM as a Judge 환경 변수 — 복사해서 .env 로 쓰세요 (cp .env.example .env)
# 모든 항목은 선택입니다. 비워 두면 기본값으로 동작하고, 키는 설정 화면에서 넣어도 됩니다.

# ── 앱 ───────────────────────────────────────────────
APP_PORT=8000
# 실행 데이터(SQLite·업로드·키 파일) 위치. Docker 에서는 /app/data (볼륨)
DATA_DIR=./data
# 값이 있으면 이 비밀번호로 로그인해야 사용할 수 있습니다. 팀 서버에 띄울 때는 꼭 설정하세요.
APP_PASSWORD=
# 저장 키 암호화 키. 비우면 DATA_DIR/secret.key 를 자동 생성합니다.
# 여러 서버가 같은 DB 를 쓰거나 키 파일을 따로 관리하려면 임의의 긴 문자열을 넣으세요.
APP_SECRET_KEY=
SESSION_HOURS=12
# 개발 모드에서 Vite(5173) 화면이 API 를 부를 때만 필요
CORS_ORIGINS=

# ── 비교 대상 호출 기본값 ─────────────────────────────
TARGET_TIMEOUT_SECONDS=30
TARGET_VERIFY_SSL=true

# ── 배치 기본값 ──────────────────────────────────────
RUN_CASE_CONCURRENCY=4
JUDGE_TIMEOUT_SECONDS=120
JUDGE_MAX_RETRIES=3

# ── 판정 모델 키 (값이 있으면 설정 화면에 저장한 키보다 우선) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Vertex AI 서비스 계정 JSON 파일 경로 + 기본 프로젝트·리전
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT=
GCP_LOCATION=

# ── 비교 대상 API 키 (비교 대상 설정의 '환경 변수 이름' 에 적은 이름과 맞춥니다) ──
# 예: ASIS_API_KEY=...
# 예: TOBE_API_KEY=...
